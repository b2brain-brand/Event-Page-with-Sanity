{
  "name": "b2brain-events",
  "version": "1.0.0",
  "private": true,
  "description": "B2Brain programmatic event landing pages — Next.js frontend + embedded Sanity Studio.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "seed": "node scripts/seed.mjs",
    "upload:gallery": "node scripts/upload-gallery.mjs",
    "apply:brand": "node scripts/apply-brand.mjs",
    "typegen": "sanity schema extract --path=./sanity/extract.json && sanity typegen generate"
  },
  "dependencies": {
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.10.1",
    "next": "^16.3.1",
    "next-sanity": "^13.3.3",
    "posthog-js": "^1.418.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.10.1",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
