# ---------------------------------------------------------------------------
# B2Brain event pages — environment
# Copy to .env.local (gitignored) and fill in. Same four vars go into Vercel.
# ---------------------------------------------------------------------------

# Public — safe to expose, they end up in the client bundle.
NEXT_PUBLIC_SANITY_PROJECT_ID=gwr013fi
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-28

# Canonical site origin — used for <link rel=canonical>, OG urls, sitemap.
NEXT_PUBLIC_SITE_URL=https://events.b2brain.com

# Server-only — NEVER prefix with NEXT_PUBLIC_.
# Viewer/read token used for draft-mode previews and live queries.
SANITY_API_READ_TOKEN=

# Server-only — used ONLY by scripts/seed.mjs to write the sample events.
# Not needed at runtime; leave blank in Vercel unless you seed from CI.
SANITY_API_WRITE_TOKEN=

# Shared secret you paste into the Sanity webhook UI (any random string).
SANITY_REVALIDATE_SECRET=
